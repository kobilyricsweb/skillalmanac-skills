{   "$schema": "https://json-schema.org/draft/2020-12/schema",   "type": "object",   "additionalProperties": false,   "required": [     "relationship_map",     "prohibited_equivalences",     "unresolved_links",     "verification_report"   ],   "properties": {     "relationship_map": {       "type": "array",       "items": {         "type": "object",         "additionalProperties": false,         "required": [           "source_term",           "target_term",           "relation_type",           "direction",           "support",           "status"         ],         "properties": {           "source_term": {             "type": "string"           },           "target_term": {             "type": "string"           },           "relation_type": {             "type": "string"           },           "direction": {             "enum": [               "directed",               "symmetric"             ]           },           "support": {             "type": "string"           },           "status": {             "enum": [               "supported",               "conflicting",               "prohibited"             ]           }         }       }     },     "prohibited_equivalences": {       "type": "array",       "items": {         "type": "object",         "additionalProperties": false,         "required": [           "terms",           "support",           "status"         ],         "properties": {           "terms": {             "type": "array",             "minItems": 2,             "maxItems": 2,             "items": {               "type": "string"             }           },           "support": {             "type": "string"           },           "status": {             "const": "prohibited"           }         }       }     },     "unresolved_links": {       "type": "array",       "items": {         "type": "object",         "additionalProperties": false,         "required": [           "terms",           "issue",           "needed_input"         ],         "properties": {           "terms": {             "type": "array",             "minItems": 2,             "maxItems": 2,             "items": {               "type": "string"             }           },           "issue": {             "type": "string"           },           "needed_input": {             "type": "string"           }         }       }     },     "verification_report": {       "type": "object",       "additionalProperties": false,       "required": [         "all_edges_supported",         "all_prohibitions_preserved",         "inverse_handling",         "unlinked_terms",         "issues"       ],       "properties": {         "all_edges_supported": {           "type": "boolean"         },         "all_prohibitions_preserved": {           "type": "boolean"         },         "inverse_handling": {           "type": "string"         },         "unlinked_terms": {           "type": "array",           "items": {             "type": "string"           }         },         "issues": {           "type": "array",           "items": {             "type": "string"           }         }       }     }   } }
