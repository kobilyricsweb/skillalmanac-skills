{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries",
    "unclassified",
    "coverage",
    "unresolved_questions",
    "scope_limits"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "kind",
          "label",
          "parent_identifier",
          "scope_description",
          "date_span",
          "access_notes",
          "certainty"
        ],
        "properties": {
          "identifier": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "folder",
              "item"
            ]
          },
          "label": {
            "type": "string"
          },
          "parent_identifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope_description": {
            "type": "string"
          },
          "date_span": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "certainty": {
            "type": "string",
            "enum": [
              "supported",
              "uncertain_placement",
              "conflicting_description"
            ]
          }
        }
      }
    },
    "unclassified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplied_identifiers",
        "represented_identifiers",
        "duplicates"
      ],
      "properties": {
        "supplied_identifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "represented_identifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}