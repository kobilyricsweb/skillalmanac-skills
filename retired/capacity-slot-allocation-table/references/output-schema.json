{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["assumptions", "input_conflicts", "allocations", "unallocated_tasks", "unresolved_tasks", "unused_slots", "feasibility_status", "verification_notes"],
  "properties": {
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "input_conflicts": {"type": "array", "items": {"type": "string"}},
    "allocations": {"type": "array", "items": {"type": "object", "required": ["task", "resource", "start", "end", "duration_hours", "supporting_rule", "status"], "properties": {"task": {"type": "string"}, "resource": {"type": "string"}, "start": {"type": "string"}, "end": {"type": "string"}, "duration_hours": {"type": "number", "exclusiveMinimum": 0}, "supporting_rule": {"type": "string"}, "status": {"enum": ["assigned", "provisional"]}}, "additionalProperties": false}},
    "unallocated_tasks": {"type": "array", "items": {"type": "object", "required": ["task", "reason"], "properties": {"task": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}},
    "unresolved_tasks": {"type": "array", "items": {"type": "object", "required": ["task", "missing_inputs"], "properties": {"task": {"type": "string"}, "missing_inputs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "unused_slots": {"type": "array", "items": {"type": "object", "required": ["resource", "start", "end"], "properties": {"resource": {"type": "string"}, "start": {"type": "string"}, "end": {"type": "string"}}, "additionalProperties": false}},
    "feasibility_status": {"enum": ["feasible", "partially_feasible", "infeasible", "undetermined"]},
    "verification_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
