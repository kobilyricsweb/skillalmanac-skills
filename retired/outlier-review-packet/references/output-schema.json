{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "missing_inputs",
    "review_items",
    "omitted_records",
    "verification_notes"
  ],
  "properties": {
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "observed_value",
          "unit",
          "triggering_rule",
          "supplied_context",
          "evidence_available",
          "evidence_gaps",
          "allowed_dispositions",
          "flag_status",
          "reviewer_decision"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "observed_value": {
            "type": [
              "number",
              "string"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "triggering_rule": {
            "type": "string"
          },
          "supplied_context": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "evidence_available": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_dispositions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flag_status": {
            "type": "string",
            "enum": [
              "flagged",
              "unresolved"
            ]
          },
          "reviewer_decision": {
            "type": "null"
          }
        },
        "additionalProperties": false
      }
    },
    "omitted_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_reference",
          "reason"
        ],
        "properties": {
          "record_reference": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "verification_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}