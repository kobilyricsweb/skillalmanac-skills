{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "scope",
    "missing_markers",
    "field_summaries",
    "subgroup_summaries",
    "co_missing_patterns",
    "excluded_or_unresolved",
    "interpretation_limits"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_markers": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "field_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "total_records",
          "missing_count",
          "missing_proportion"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "total_records": {
            "type": "integer",
            "minimum": 0
          },
          "missing_count": {
            "type": "integer",
            "minimum": 0
          },
          "missing_proportion": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "subgroup_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subgroup",
          "size",
          "field",
          "missing_count",
          "missing_proportion"
        ],
        "properties": {
          "subgroup": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "field": {
            "type": "string"
          },
          "missing_count": {
            "type": "integer",
            "minimum": 0
          },
          "missing_proportion": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "co_missing_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fields",
          "record_ids",
          "count"
        ],
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "record_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "excluded_or_unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}