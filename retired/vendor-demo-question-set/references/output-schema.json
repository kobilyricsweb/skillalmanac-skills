{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "objective",
    "assumptions",
    "timed_script",
    "traceability",
    "evidence_requests",
    "follow_up_questions",
    "non_demonstrable",
    "overflow",
    "verification"
  ],
  "properties": {
    "objective": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timed_script": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_ids",
          "segment",
          "duration_minutes",
          "timing_basis",
          "live_action_request",
          "observable_result",
          "status"
        ],
        "properties": {
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "segment": {
            "type": "string"
          },
          "duration_minutes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "timing_basis": {
            "enum": [
              "supplied",
              "provisional",
              "unknown"
            ]
          },
          "live_action_request": {
            "type": "string"
          },
          "observable_result": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "deferred",
              "non_demonstrable",
              "conflicting"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "priority",
          "status",
          "script_segments"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "priority": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "deferred",
              "non_demonstrable",
              "conflicting"
            ]
          },
          "script_segments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "demo_evidence",
          "later_validation_evidence"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "demo_evidence": {
            "type": "string"
          },
          "later_validation_evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "question"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "non_demonstrable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "reason",
          "needed_condition"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "needed_condition": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "overflow": {
      "type": "object",
      "required": [
        "duration_cap_minutes",
        "in_cap_planned_minutes",
        "total_requested_minutes",
        "arithmetic_overflow_minutes",
        "deferred_minutes",
        "full_scope_feasible",
        "in_cap_agenda_feasible"
      ],
      "properties": {
        "duration_cap_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "in_cap_planned_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_requested_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "arithmetic_overflow_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "deferred_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "full_scope_feasible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "in_cap_agenda_feasible": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "all_requirements_have_status",
        "duration_arithmetic_checked",
        "vendor_capabilities_claimed_as_observed",
        "unresolved_validation_owner"
      ],
      "properties": {
        "all_requirements_have_status": {
          "type": "boolean"
        },
        "duration_arithmetic_checked": {
          "type": "boolean"
        },
        "vendor_capabilities_claimed_as_observed": {
          "type": "boolean"
        },
        "unresolved_validation_owner": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
