{
  "note": "Expected values were worked out by hand from the CSV and scheme files (see VERIFICATION.md), then compared with the script output. 'fx:' marks a path inside evals/fixtures.",
  "never_in_output": ["Quillfeather", "Brantwhistle", "Padgett", "Thornbury", "Wrenfield", "Ainsworth", "Harrowgate", "Calloway", "Nameless"],
  "cases": [
    {"name": "good scheme, exclude policy",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--missing", "exclude"], "exit": 0,
     "expect": {"scheme_ok": true, "finals": {"S01": 89.0, "S02": 90.4, "S03": 76.5, "S04": 88.6, "S05": 90.0},
                "letters": {"S01": "B", "S02": "A", "S03": "C", "S04": "B", "S05": "A"},
                "boundary_ids": ["S02", "S05"], "mismatch_ids": [],
                "flag_counts": {"category_absent": 1, "letter_depends_on_missing_policy": 1, "missing_score": 2, "rounding_changes_letter": 1},
                "unmapped_columns": ["name"], "expected_compared": 5}},
    {"name": "good scheme, zero policy",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--missing", "zero"], "exit": 1,
     "expect": {"scheme_ok": true, "finals": {"S01": 89.0, "S02": 90.4, "S03": 75.0, "S04": 62.0, "S05": 90.0},
                "letters": {"S04": "D"}, "mismatch_ids": ["S03", "S04"]}},
    {"name": "good scheme, default flag policy marks provisional results",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json"], "exit": 0,
     "expect": {"finals": {"S03": 76.5, "S04": 88.6}, "provisional_ids": ["S03", "S04"]}},
    {"name": "recorded finals that disagree",
     "args": ["fx:scores_mismatch.csv", "fx:scheme_good.json", "--missing", "exclude"], "exit": 1,
     "expect": {"mismatch_ids": ["S02", "S03", "S05"], "explained_by": {"S02": null, "S03": "zero", "S05": null}}},
    {"name": "dirty scores: duplicate id, blank id, negative, above max, text, excused",
     "args": ["fx:scores_dirty.csv", "fx:scheme_good.json", "--missing", "zero"], "exit": 0,
     "expect": {"finals": {"D01": 92.0, "D02": 71.4, "D03": 48.0}, "duplicate_ids": {"D01": [2, 4]}, "blank_id_rows": [5],
                "flag_counts": {"category_absent": 1, "duplicate_id": 1, "letter_depends_on_missing_policy": 2, "missing_score": 5,
                                "negative_score": 1, "non_numeric_score": 1, "score_above_max": 1},
                "students_total": 3}},
    {"name": "invalid scheme",
     "args": ["fx:scores_good.csv", "fx:scheme_bad.json"], "exit": 1,
     "expect": {"scheme_ok": false, "problem_codes": ["drop_leaves_zero", "empty_category", "item_in_two_categories", "unsupported_key", "weights_not_100"],
                "students_total": 0}},
    {"name": "what-if: minimum final exam score for an 80",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--missing", "exclude", "--what-if", "Final", "--target", "80"], "exit": 0,
     "expect": {"what_if": {"S04": {"needed_score": 59.84, "feasible": true}}}},
    {"name": "what-if: minimum final exam score for a 90",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--missing", "exclude", "--what-if", "Final", "--target", "90"], "exit": 0,
     "expect": {"what_if": {"S04": {"needed_score": 93.17, "feasible": true}}}},
    {"name": "what-if: target out of reach",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--missing", "exclude", "--what-if", "Final", "--target", "95"], "exit": 0,
     "expect": {"what_if": {"S04": {"needed_score": null, "feasible": false}}}},
    {"name": "refuses to write the report over the scores file, even with --force",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--out", "fx:scores_good.csv", "--force"], "exit": 2,
     "expect": {"stderr_contains": "refusing to write the report over an input file"}},
    {"name": "refuses to write the report over the scheme file, even with --force",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--out", "fx:scheme_good.json", "--force"], "exit": 2,
     "expect": {"stderr_contains": "refusing to write the report over an input file"}},
    {"name": "refuses to replace an existing file without --force",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--out", "fx:cases.json"], "exit": 2,
     "expect": {"stderr_contains": "already exists"}},
    {"name": "missing scheme file",
     "args": ["fx:scores_good.csv", "fx:no_such_scheme.json"], "exit": 2,
     "expect": {"stderr_contains": "cannot read"}},
    {"name": "wrong id column",
     "args": ["fx:scores_good.csv", "fx:scheme_good.json", "--id-column", "sid"], "exit": 2,
     "expect": {"stderr_contains": "id column"}}
  ]
}
