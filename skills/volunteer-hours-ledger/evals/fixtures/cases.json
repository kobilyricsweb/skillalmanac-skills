    },
    {
      "args": ["@rounding.csv", "--round-unit", "15", "--round-mode", "up"],
      "exit": 0,
      "expect": {"totals.hours": 2.25}
    },
    {
      "args": ["@rounding.csv", "--round-unit", "15", "--round-mode", "down"],
      "exit": 0,
      "expect": {"totals.hours": 1.5}
    },
    {
      "args": ["@headerless.txt"],
      "exit": 0,
      "expect": {
        "settings.signoff_checked": false,
