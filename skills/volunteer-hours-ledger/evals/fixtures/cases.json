    {
      "args": ["@overnight.csv", "--allow-overnight"],
      "exit": 0,
      "expect": {"totals.hours": 4.0, "flag_types": ["overnight_shift"]}
    },
    {
      "args": ["@good.csv", "--output", "@good.csv"],
      "exit": 2,
      "expect": {},
      "unchanged": "good.csv"
    },
    {
      "args": ["@good.csv", "--output", "@good.csv", "--force"],
      "exit": 2,
      "expect": {},
      "unchanged": "good.csv"
    },
    {
      "args": ["@bad.csv", "--roster", "@roster.txt", "--output", "@roster.txt", "--force"],
