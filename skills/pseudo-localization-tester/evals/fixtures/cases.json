{
  "note": "Each case runs scripts/pseudo_localize.py. In args, {fx} is evals/fixtures and {tmp} is a fresh temporary directory. 'expect' lists derived report fields; 'expect_output' compares the written file with a hand-checked file under expected/; 'unchanged' lists fixtures whose SHA-256 must not change; 'absent' lists paths that must not exist afterwards; 'twice' runs the command twice and judges the second run.",
  "cases": [
    {"name": "json default", "args": ["{fx}/en.json", "--output", "{tmp}/en.pseudo.json"], "exit": 0,
     "expect": {"strings_total": 10, "transformed": 9, "placeholders_checked": 14, "placeholder_mismatches": [], "round_trip_ok": true, "ok": true,
       "no_letters": ["app.version"],
       "fragment_keys": ["app.welcome_prefix", "app.welcome_prefix", "app.welcome_prefix", "app.unread"],
       "html_keys": ["app.terms"], "unnamed_keys": ["app.files_deleted"],
       "baked": [["app.last_seen", "date"], ["app.unread", "number"]], "written": true},
     "expect_output": {"{tmp}/en.pseudo.json": "expected/en.pseudo.json"}},
    {"name": "json with limits and source scan", "args": ["{fx}/en.json", "--limits", "{fx}/limits.json", "--scan-dir", "{fx}/src", "--dry-run"], "exit": 0,
     "expect": {"overflow": [["app.greeting", "source_over_limit", -29], ["app.save", "pseudo_exceeds_limit", 25], ["app.title", "pseudo_exceeds_limit", 16]],
       "hardcoded_lines": [5, 6, 7, 8, 9],
       "hardcoded_matches": [null, null, null, null, "app.title"],
       "warnings": ["limit key not found in source: app.missing_key"], "written": false, "output_file": null}},
    {"name": "properties level 4", "args": ["{fx}/messages.properties", "--level", "4", "--output", "{tmp}/messages.pseudo.properties"], "exit": 0,
     "expect": {"strings_total": 6, "transformed": 6, "placeholders_checked": 3, "round_trip_ok": true, "baked": [["copyright", "number"]]},
     "expect_output": {"{tmp}/messages.pseudo.properties": "expected/messages.pseudo.properties"}},
    {"name": "po level 2 with plurals and context", "args": ["{fx}/app.po", "--level", "2", "--output", "{tmp}/app.pseudo.po"], "exit": 0,
     "expect": {"strings_total": 5, "transformed": 5, "placeholders_checked": 3, "round_trip_ok": true, "fragment_keys": []},
     "expect_output": {"{tmp}/app.pseudo.po": "expected/app.pseudo.po"}},
    {"name": "tiered expansion", "args": ["{fx}/tiny.json", "--expansion", "tiered", "--output", "{tmp}/tiny.json"], "exit": 0,
     "expect": {"strings_total": 2, "transformed": 2, "expansion": "tiered"},
     "expect_output": {"{tmp}/tiny.json": "expected/tiny.tiered.json"}},
    {"name": "icu, dollar-brace, double-brace, unbalanced brace", "args": ["{fx}/broken.json", "--dry-run"], "exit": 0,
     "expect": {"strings_total": 3, "placeholders_checked": 10, "placeholder_mismatches": [], "ok": true,
       "warnings": ["b: unbalanced { treated as text: {name and more"], "baked": [["c", "number"]]}},
    {"name": "refuses output equal to source even with force", "args": ["{fx}/en.json", "--output", "{fx}/en.json", "--force"], "exit": 2,
     "unchanged": ["en.json"]},
    {"name": "refuses report equal to source even with force", "args": ["{fx}/en.json", "--output", "{tmp}/o.json", "--report", "{fx}/en.json", "--force"], "exit": 2,
     "unchanged": ["en.json"], "absent": ["{tmp}/o.json"]},
    {"name": "refuses report equal to limits file", "args": ["{fx}/en.json", "--limits", "{fx}/limits.json", "--output", "{tmp}/o.json", "--report", "{fx}/limits.json", "--force"], "exit": 2,
     "unchanged": ["limits.json"], "absent": ["{tmp}/o.json"]},
    {"name": "refuses output inside the scanned directory", "args": ["{fx}/en.json", "--scan-dir", "{fx}/src", "--output", "{fx}/src/x.json", "--force"], "exit": 2,
     "absent": ["{fx}/src/x.json"]},
    {"name": "does not replace an existing output without force", "args": ["{fx}/en.json", "--output", "{tmp}/again.json"], "twice": true, "exit": 2},
    {"name": "missing source", "args": ["{fx}/nope.json"], "exit": 2},
    {"name": "invalid json source", "args": ["{fx}/messages.properties", "--format", "json", "--dry-run"], "exit": 2}
  ]
}
