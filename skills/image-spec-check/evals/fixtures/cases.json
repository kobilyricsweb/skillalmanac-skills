{
  "note": "Expected values were worked out by hand from the spec rules before the first run (see VERIFICATION.md). Images are generated by evals/make_samples.py. Placeholders: {dir} sample folder, {specs} fixtures/specs.csv, {specs_copy} a temp copy of it, {badspecs} fixtures/specs_bad_column.csv, {tmp} a temp folder.",
  "cases": [
    {
      "id": "hero-folder", "group": "hero",
      "args": ["--specs", "{specs}", "--spec", "hero", "{dir}"], "exit": 1,
      "expect": {
        "ok": false,
        "by_status": {"pass": 1, "resize": 1, "crop_or_pad": 1, "reexport": 3, "unreadable": 1},
        "statuses": {
          "hero_ok.jpg": {"hero": ["pass", []]},
          "hero_1px.jpg": {"hero": ["resize", ["size_mismatch"]]},
          "hero_wide.jpg": {"hero": ["crop_or_pad", ["aspect_mismatch"]]},
          "hero_big.jpg": {"hero": ["reexport", ["over_size"]]},
          "hero_wrongext.jpg": {"hero": ["reexport", ["extension_mismatch", "format_not_allowed"]]},
          "hero_trunc.jpg": {"hero": ["unreadable", ["truncated"]]},
          "hero_small.webp": {"hero": ["reexport", ["size_mismatch", "too_small"]]}
        },
        "extras": [
          {"file": "hero_wide.jpg", "spec": "hero", "path": "suggest.crop_box", "value": {"x": 400, "y": 0, "w": 1600, "h": 900}},
          {"file": "hero_wide.jpg", "spec": "hero", "path": "suggest.kept_percent", "value": 66.7},
          {"file": "hero_wide.jpg", "spec": "hero", "path": "suggest.pad_canvas", "value": {"w": 2400, "h": 1350}},
          {"file": "hero_1px.jpg", "spec": "hero", "path": "suggest.target", "value": {"w": 1600, "h": 900}},
          {"file": "hero_1px.jpg", "spec": "hero", "path": "suggest.op", "value": "scale"},
          {"file": "hero_big.jpg", "spec": "hero", "path": "advice", "value": "keep_format_tune"},
          {"file": "hero_wrongext.jpg", "spec": "hero", "path": "advice", "value": "flat_use_webp"},
          {"file": "hero_wrongext.jpg", "spec": null, "path": "format", "value": "png"},
          {"file": "hero_small.webp", "spec": null, "path": "w", "value": 800},
          {"file": "hero_small.webp", "spec": null, "path": "h", "value": 450}
        ]
      }
    },
    {
      "id": "print-dpi", "group": "print",
      "args": ["--specs", "{specs}", "--spec", "print-a5", "{dir}"], "exit": 1,
      "expect": {
        "ok": false,
        "by_status": {"pass": 4, "reexport": 3, "unreadable": 1},
        "statuses": {
          "a5_300.png": {"print-a5": ["pass", []]},
          "a5_nodpi.png": {"print-a5": ["reexport", ["dpi_missing"]]},
          "a5_72.png": {"print-a5": ["reexport", ["dpi_low"]]},
          "a5_jfif.jpg": {"print-a5": ["pass", []]},
          "a5_exif.jpg": {"print-a5": ["pass", []]},
          "a5_dpcm.jpg": {"print-a5": ["pass", []]},
          "a5_jfif_aspect.jpg": {"print-a5": ["reexport", ["dpi_missing"]]},
          "empty.png": {"print-a5": ["unreadable", ["empty_file"]]}
        },
        "extras": [
          {"file": "a5_300.png", "spec": null, "path": "dpi.x", "value": 300.0},
          {"file": "a5_300.png", "spec": null, "path": "dpi.source", "value": "pHYs"},
          {"file": "a5_300.png", "spec": "print-a5", "path": "suggest.max_print_size_in", "value": [5.83, 8.27]},
          {"file": "a5_72.png", "spec": null, "path": "dpi.x", "value": 72.0},
          {"file": "a5_jfif.jpg", "spec": null, "path": "dpi.source", "value": "JFIF"},
          {"file": "a5_exif.jpg", "spec": null, "path": "dpi.source", "value": "EXIF"},
          {"file": "a5_exif.jpg", "spec": null, "path": "dpi.x", "value": 300.0},
          {"file": "a5_dpcm.jpg", "spec": null, "path": "dpi.x", "value": 299.7},
          {"file": "a5_jfif_aspect.jpg", "spec": null, "path": "dpi", "value": null}
        ]
      }
    },
    {
      "id": "banner-ratio", "group": "banner",
      "args": ["--specs", "{specs}", "--spec", "banner-ratio", "{dir}"], "exit": 1,
      "expect": {
        "ok": false,
        "by_status": {"pass": 2, "resize": 1, "crop_or_pad": 1, "reexport": 2},
        "statuses": {
          "banner_1200x628.png": {"banner-ratio": ["pass", []]},
          "banner_1200x630.png": {"banner-ratio": ["pass", []]},
          "banner_1000x600.png": {"banner-ratio": ["crop_or_pad", ["aspect_mismatch"]]},
          "banner_1200x640.png": {"banner-ratio": ["resize", ["aspect_drift"]]},
          "banner_a.gif": {"banner-ratio": ["reexport", ["format_not_allowed"]]},
          "banner.svg": {"banner-ratio": ["reexport", ["format_not_allowed"]]}
        },
        "extras": [
          {"file": "banner_1000x600.png", "spec": "banner-ratio", "path": "suggest.crop_box", "value": {"x": 0, "y": 38, "w": 1000, "h": 524}},
          {"file": "banner_1000x600.png", "spec": "banner-ratio", "path": "suggest.kept_percent", "value": 87.3},
          {"file": "banner_1000x600.png", "spec": "banner-ratio", "path": "suggest.pad_canvas", "value": {"w": 1146, "h": 600}},
          {"file": "banner_1200x640.png", "spec": "banner-ratio", "path": "suggest.target", "value": {"w": 1200, "h": 628}},
          {"file": "banner_a.gif", "spec": "banner-ratio", "path": "advice", "value": "flat_use_png"},
          {"file": "banner.svg", "spec": "banner-ratio", "path": "advice", "value": "flat_use_png"},
          {"file": "banner.svg", "spec": null, "path": "vector", "value": true},
          {"file": "banner.svg", "spec": null, "path": "w", "value": 1910}
        ]
      }
    },
    {
      "id": "thumb-max", "group": "thumb",
      "args": ["--specs", "{specs}", "--spec", "thumb-max", "{dir}"], "exit": 1,
      "expect": {
        "ok": false,
        "by_status": {"pass": 1, "resize": 1, "reexport": 2, "unreadable": 1},
        "statuses": {
          "thumb_ok.png": {"thumb-max": ["pass", []]},
          "thumb_big.png": {"thumb-max": ["resize", ["too_large"]]},
          "thumb_flat.png": {"thumb-max": ["reexport", ["over_size"]]},
          "thumb_photo.png": {"thumb-max": ["reexport", ["over_size"]]},
          "broken.png": {"thumb-max": ["unreadable", ["unreadable_header"]]}
        },
        "extras": [
          {"file": "thumb_big.png", "spec": "thumb-max", "path": "suggest.target", "value": {"w": 640, "h": 360}},
          {"file": "thumb_big.png", "spec": "thumb-max", "path": "suggest.op", "value": "scale_to_fit"},
          {"file": "thumb_flat.png", "spec": "thumb-max", "path": "advice", "value": "keep_format_tune"},
          {"file": "thumb_photo.png", "spec": "thumb-max", "path": "advice", "value": "photo_use_jpeg"}
        ]
      }
    },
    {
      "id": "one-file-all-specs", "group": "hero",
      "args": ["--specs", "{specs}", "{dir}/hero_ok.jpg"], "exit": 1,
      "expect": {
        "ok": false,
        "by_status": {"pass": 1, "resize": 0, "crop_or_pad": 1, "reexport": 3, "unreadable": 0},
        "statuses": {
          "hero_ok.jpg": {
            "hero": ["pass", []],
            "square": ["reexport", ["aspect_mismatch", "too_small"]],
            "banner-ratio": ["crop_or_pad", ["aspect_mismatch"]],
            "print-a5": ["reexport", ["dpi_missing", "aspect_mismatch", "too_small"]],
            "thumb-max": ["reexport", ["over_size", "too_large"]]
          }
        },
        "extras": [
          {"file": "hero_ok.jpg", "spec": "square", "path": "suggest.crop_box", "value": {"x": 350, "y": 0, "w": 900, "h": 900}},
          {"file": "hero_ok.jpg", "spec": "banner-ratio", "path": "suggest.crop_box", "value": {"x": 0, "y": 31, "w": 1600, "h": 838}},
          {"file": "hero_ok.jpg", "spec": "print-a5", "path": "suggest.crop_box", "value": {"x": 483, "y": 0, "w": 634, "h": 900}},
          {"file": "hero_ok.jpg", "spec": "thumb-max", "path": "suggest.target", "value": {"w": 640, "h": 360}}
        ]
      }
    },
    {
      "id": "all-pass", "group": "hero",
      "args": ["--specs", "{specs}", "--spec", "hero", "{dir}/hero_ok.jpg"], "exit": 0,
      "expect": {"ok": true, "by_status": {"pass": 1}, "statuses": {"hero_ok.jpg": {"hero": ["pass", []]}}, "extras": []}
    },
    {
      "id": "out-refuses-image", "group": "thumb",
      "args": ["--specs", "{specs}", "--spec", "thumb-max", "{dir}", "--out", "{dir}/thumb_ok.png", "--force"], "exit": 2,
      "expect": {}, "unchanged": ["{dir}/thumb_ok.png"]
    },
    {
      "id": "out-refuses-spec-file", "group": "thumb",
      "args": ["--specs", "{specs_copy}", "--spec", "thumb-max", "{dir}", "--out", "{specs_copy}", "--force"], "exit": 2,
      "expect": {}, "unchanged": ["{specs_copy}"]
    },
    {
      "id": "out-new-file", "group": "thumb",
      "args": ["--specs", "{specs}", "--spec", "thumb-max", "{dir}", "--out", "{tmp}/report.json"], "exit": 1,
      "expect": {}, "out_matches_stdout": "{tmp}/report.json"
    },
    {
      "id": "unknown-spec-name", "group": "thumb",
      "args": ["--specs", "{specs}", "--spec", "nope", "{dir}"], "exit": 2, "expect": {}
    },
    {
      "id": "bad-spec-column", "group": "thumb",
      "args": ["--specs", "{badspecs}", "{dir}"], "exit": 2, "expect": {}
    },
    {
      "id": "missing-path", "group": "thumb",
      "args": ["--specs", "{specs}", "{dir}/not_there.png"], "exit": 2, "expect": {}
    }
  ]
}
