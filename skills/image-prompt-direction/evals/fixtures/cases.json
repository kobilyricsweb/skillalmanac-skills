{
  "note": "Expected values were checked by hand against each fixture file (see VERIFICATION.md).",
  "cases": [
    {"args": ["lint", "good_labelled.txt"], "exit": 0,
     "expect": {"verdict": "pass", "score": 100, "codes": []}},
    {"args": ["lint", "good_free.txt"], "exit": 0,
     "expect": {"verdict": "pass", "score": 100, "codes": []}},
    {"args": ["lint", "negation_ok.txt"], "exit": 0,
     "expect": {"verdict": "pass", "score": 100, "codes": []}},
    {"args": ["lint", "bad_rights.txt"], "exit": 1,
     "expect": {"verdict": "blocked", "score": 90,
                "codes": ["missing-field", "rights-living-artist", "rights-real-person", "rights-trademark", "rights-trademark", "possible-artist-name"]}},
    {"args": ["lint", "bad_rights.txt", "--allow", "Coca-Cola"], "exit": 1,
     "expect": {"verdict": "blocked", "score": 90,
                "codes": ["missing-field", "rights-living-artist", "rights-real-person", "rights-trademark", "possible-artist-name"]}},
    {"args": ["lint", "bad_rights_unlabelled.txt"], "exit": 1,
     "expect": {"verdict": "blocked", "score": 100,
                "codes": ["rights-real-person", "rights-trademark", "rights-likeness", "possible-brand-mark"]}},
    {"args": ["lint", "bad_contradiction.txt"], "exit": 1,
     "expect": {"verdict": "revise", "score": 100,
                "codes": ["contradiction", "contradiction", "contradiction", "contradiction"]}},
    {"args": ["lint", "bad_aspect.txt"], "exit": 1,
     "expect": {"verdict": "revise", "score": 100, "codes": ["aspect-invalid", "filler-token", "filler-token"]}},
    {"args": ["lint", "incomplete.txt"], "exit": 1,
     "expect": {"verdict": "revise", "score": 20,
                "codes": ["missing-field", "missing-field", "missing-field", "missing-field", "missing-field", "missing-field", "missing-field", "too-short"]}},
    {"args": ["lint", "does_not_exist.txt"], "exit": 2, "expect": {}},
    {"args": ["diff", "iter_v1.txt", "iter_v2_one_change.txt"], "exit": 0,
     "expect": {"ok": true, "changed_fields": ["lighting"]}},
    {"args": ["diff", "iter_v1.txt", "iter_v2_two_changes.txt"], "exit": 1,
     "expect": {"ok": false, "changed_fields": ["composition", "lighting"]}},
    {"args": ["diff", "good_free.txt", "iter_v1.txt"], "exit": 2, "expect": {}}
  ]
}
