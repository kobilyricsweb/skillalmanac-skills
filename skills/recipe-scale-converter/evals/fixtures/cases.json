      "exit": 0,
      "expect": {
        "scaled_list": ["Dry:", "270 g all-purpose flour", "1 1/2 tsp baking powder", "3 g salt", "230 g butter, softened", "300 g granulated sugar", "3 large eggs", "1 tbsp vanilla extract", "250 g milk", "salt to taste"],
        "warning_codes": [],
        "flags": [["header"], [], ["no_density"], [], [], [], [], ["no_density"], [], ["no_quantity"]],
        "confidence": ["n/a", "high", "low", "medium", "high", "high", "high", "low", "high", "n/a"]
      }
    },
    {
      "id": "cake-x1-user-density-overrides",
      "args": ["cake.txt", "--factor", "1", "--units", "metric", "--basis", "mass", "--density", "density_user.csv"],
