      "args": ["cake.txt", "--factor", "1.5"],
      "exit": 0,
      "expect": {
        "factor": 1.5,
        "scaled_list": ["Dry:", "3 3/8 cups all-purpose flour", "2 1/4 tsp baking powder", "3/4 tsp salt", "1 1/2 cups (340 g) butter, softened", "2 1/4 cups granulated sugar", "4 1/2 large eggs", "1 1/2 tbsp vanilla extract", "1 1/2 cups milk", "salt to taste"],
        "warning_codes": ["COOK_TIME"],
        "flags": [["header"], [], [], [], [], [], ["fractional_egg"], [], [], ["no_quantity"]],
        "unparsed_count": 0
      }
    },
    {
      "id": "cake-x1-metric-mass-bundled-density",
