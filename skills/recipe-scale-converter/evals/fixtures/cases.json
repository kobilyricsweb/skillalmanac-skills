      "expect": {
        "scaled_list": ["Dry:", "290 g all-purpose flour", "1 1/2 tsp baking powder", "3 g salt", "230 g butter, softened", "300 g granulated sugar", "3 large eggs", "1 tbsp vanilla extract", "250 g milk", "salt to taste"],
        "confidence": ["n/a", "high", "low", "medium", "high", "high", "high", "low", "high", "n/a"]
      }
    },
    {
      "id": "chili-4-to-20-servings",
      "args": ["chili.txt", "--from-servings", "4", "--to-servings", "20"],
      "exit": 1,
      "expect": {
        "factor": 5.0,
        "scaled_list": ["5/8-1 1/4 cups olive oil", "2 1/2 tsp cayenne pepper", "2 1/2 tbsp salt", "5 (14 oz) cans tomatoes", "10 cups beef stock", "5 sticks butter", "5 sticks cinnamon", "10 sacks of potatoes", "5 cups flour", "1 kg flour"],
        "warning_codes": ["FACTOR_HIGH", "COOK_TIME"],
        "flags": [[], ["nonlinear_spice"], ["nonlinear_salt"], [], ["nonlinear_simmer"], [], ["ambiguous_unit", "nonlinear_spice"], ["unknown_unit"], ["unit_mismatch"], ["unit_mismatch"]],
        "confidence": ["high", "medium", "medium", "high", "medium", "high", "low", "low", "medium", "medium"],
        "unparsed_reasons": ["zero denominator in the quantity", "number written as a word; rewrite it with digits"]
      }
    },
    {
      "id": "brownies-pan-9x13-to-8x8",
      "args": ["brownies.txt", "--from-pan", "9x13", "--to-pan", "8x8"],
