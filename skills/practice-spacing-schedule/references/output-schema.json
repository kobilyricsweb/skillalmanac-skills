{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schedule_status",
    "sessions",
    "deferred_items",
    "unused_capacity_report",
    "constraint_audit",
    "assumptions"
  ],
  "properties": {
    "schedule_status": {
      "type": "string",
      "enum": [
        "feasible",
        "partial",
        "conflict"
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "capacity",
          "placements",
          "unused_capacity",
          "over_capacity"
        ],
        "properties": {
          "session": {
            "type": "integer",
            "minimum": 1
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot",
                "item_id",
                "skill_tag",
                "labels",
                "reason",
                "review_of_session"
              ],
              "properties": {
                "slot": {
                  "type": "integer",
                  "minimum": 1
                },
                "item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "skill_tag": {
                  "type": "string",
                  "minLength": 1
                },
                "labels": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "new",
                      "retrieval_review",
                      "cumulative_mixing"
                    ]
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "review_of_session": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              }
            }
          },
          "unused_capacity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "over_capacity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "deferred_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "reason"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unused_capacity_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_unused",
        "by_session"
      ],
      "properties": {
        "total_unused": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "by_session": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session",
              "unused"
            ],
            "properties": {
              "session": {
                "type": "integer",
                "minimum": 1
              },
              "unused": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "constraint_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prerequisites",
        "capacities",
        "review_intervals",
        "conflicts",
        "unresolved_constraints"
      ],
      "properties": {
        "prerequisites": {
          "type": "string",
          "enum": [
            "satisfied",
            "conflict",
            "unknown",
            "not_applicable"
          ]
        },
        "capacities": {
          "type": "string",
          "enum": [
            "satisfied",
            "conflict",
            "unknown"
          ]
        },
        "review_intervals": {
          "type": "string",
          "enum": [
            "satisfied",
            "conflict",
            "unknown",
            "not_applicable"
          ]
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
